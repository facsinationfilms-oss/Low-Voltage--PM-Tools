{
  "name": "B&S Office Hub",
  "short_name": "B&S Hub",
  "description": "Jobs, schedule, tasks, notes, floor-plan markups and B&S Layout blueprints in one app.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#070C17",
  "theme_color": "#0F1729",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-bsmap": [".bsmap"] }, "launch_type": "single-client" }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
